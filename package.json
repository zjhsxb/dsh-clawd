{
  "name": "dsh-clawd",
  "version": "0.1.1",
  "description": "Clawd娘: a Claude-inspired pixel crab desktop pet for DeepSeek Harness. Non-official fan work, not affiliated with Anthropic.",
  "license": "MIT",
  "author": "dsh-clawd contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjhsxb/dsh-clawd.git"
  },
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.svg",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "client.js",
    "cordis.patch.yml",
    "assets/",
    "locale/",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-layout"],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible",
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.3": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "preview": "node scripts/preview.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "desktop-pet",
    "claude",
    "clawd",
    "plugin"
  ]
}
